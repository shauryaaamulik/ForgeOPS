# Copy to server/.env for local development
PORT=4000
# Transactions require a replica set (docker-compose starts one as rs0)
MONGO_URI=mongodb://localhost:27017/forgeops?replicaSet=rs0
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-long-random-string
CLIENT_ORIGIN=http://localhost:5173
